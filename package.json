{
  "name": "plainstate",
  "version": "0.1.0",
  "description": "A controlled-natural-language notation for finite state machines that round-trips losslessly with JSON",
  "type": "module",
  "bin": {
    "plainstate": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "state-machine",
    "fsm",
    "dsl",
    "plain",
    "round-trip"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
